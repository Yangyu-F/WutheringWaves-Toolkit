{
  "name": "wutheringwaves-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "data:validate": "tsx scripts/validate-data.ts",
    "wiki:snapshot": "tsx scripts/wiki/download-kuro-wiki.ts",
    "wiki:process": "tsx scripts/wiki/process-kuro-wiki.ts",
    "wiki:community-snapshot": "tsx scripts/wiki/download-community-wikis.ts",
    "wiki:wikiwiki-resonators": "tsx scripts/wiki/download-wikiwiki-resonators.ts",
    "wiki:candidates": "tsx scripts/wiki/normalize-candidates.ts"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.5"
  }
}
